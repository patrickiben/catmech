Encoding: UTF-8
Depends: R (>= 4.1.0)
Imports: digest, jsonlite, mice (>= 3.16.0), posterior, stats, truncnorm, utils, yaml
Suggests: testthat (>= 3.0.0), roxygen2, pkgload
